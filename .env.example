# Configuração do bucket AWS para vídeos de introdução e encerramento
# IMPORTANTE: Estas credenciais são para o bucket FIXO de assets (vídeos de intro/outro)
# NÃO confundir com a configuração S3 do usuário (que é apenas para upload de gravações)

# Credenciais AWS do bucket de assets
AWS_ASSETS_ACCESS_KEY_ID=sua_access_key_id_aqui
AWS_ASSETS_SECRET_ACCESS_KEY=sua_secret_access_key_aqui

# Região do bucket de assets
AWS_ASSETS_REGION=us-east-1

# Nome do bucket onde ficam os vídeos de intro/outro
AWS_ASSETS_BUCKET_NAME=cardiopicreport

# NOTA: O folderPrefix "assets" é fixo no código e não precisa de variável de ambiente
